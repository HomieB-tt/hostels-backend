# Copy to .env and fill in real values for anything marked CHANGE ME.
# Nothing here has a fallback in code — src/env.ts fails the process at
# boot if any of these is missing, empty, or malformed.

NODE_ENV=development
PORT=8080

# --- Database ---
# docker-compose overrides this to point at the `postgres` service; only
# needed here if you run the app outside docker-compose.
SUPABASE_DATABASE_URL=postgres://hostel_platform:hostel_platform_dev_password@localhost:5432/hostel_platform
SUPABASE_URL=https://CHANGE-ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_service_role_key
SUPABASE_ANON_KEY=CHANGE_ME_anon_key

# --- Auth (32+ chars; generate with `openssl rand -hex 32`) ---
JWT_ACCESS_SECRET=c6f3e813ee9c7ce1de2032f047615f7e67ebf04eeb8b48a47d422ca4b1d0ecce
JWT_REFRESH_SECRET=f099f86cc9a5c17d692a2a4531a73d01fded1a82dcc5f10a4cc5782df6970dc8
JWT_ACCESS_TTL_WEB=15m
JWT_REFRESH_TTL_MOBILE=90d

# --- QStash ---
# These four are the FIXED, publicly-documented credentials for the
# `qstash dev` local server started by docker-compose (service:
# qstash-dev). They only work against that local server — swap in your
# real Upstash console values for anything other than local dev.
# https://upstash.com/docs/qstash/howto/local-development
QSTASH_URL=http://localhost:8085
QSTASH_TOKEN=eyJVc2VySUQiOiJkZWZhdWx0VXNlciIsIlBhc3N3b3JkIjoiZGVmYXVsdFBhc3N3b3JkIn0=
QSTASH_CURRENT_SIGNING_KEY=sig_5Ag5v2D1zVHzSAnxTc3LZ97nb7Df
QSTASH_NEXT_SIGNING_KEY=sig_6otveSLQEeKfTj7sxj5cM3DW8J4L

# --- Pesapal 3.0 ---
# Use the sandbox host for local/dev testing, production host for real
# transactions.
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=CHANGE_ME
PESAPAL_CONSUMER_SECRET=CHANGE_ME
PESAPAL_IPN_ID=CHANGE_ME

# --- SMS: Africa's Talking (primary) ---
AT_API_KEY=CHANGE_ME
AT_USERNAME=sandbox

# --- SMS/WhatsApp fallback: Twilio ---
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- FCM push ---
FCM_PROJECT_ID=CHANGE_ME
FCM_CLIENT_EMAIL=CHANGE_ME@CHANGE-ME.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"

# --- CORS ---
WEB_DASHBOARD_ORIGIN=http://localhost:3000
